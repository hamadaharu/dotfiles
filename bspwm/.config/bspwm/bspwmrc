#! /bin/sh

bspc external_rules_command ./x.sh

exec_once (){
    pgrep -x "$1" > /dev/null || "$@"  &
}

# pgrep -x sxhkd > /dev/null || sxhkd &
sxhkd -c $HOME/.config/sxhkd/sxhkdrc $HOME/.config/sxhkd/bspwm &

bspc monitor -d 1 2 3 4 5 6

bspc config border_width            2
bspc config window_gap              12

bspc config split_ratio             0.52
bspc config borderless_monocle      true
bspc config gapless_monocle         true
bspc config focus_follows_pointer   true
bspc config single_monocle          true

# Apps Rules
bspc rule -a Gimp desktop='^6' state=floating follow=on
bspc rule -a TelegramDesktop desktop='^6'
bspc rule -a Gpick state=floating
# browser
bspc rule -a Chromium desktop='^2'
bspc rule -a Firefox desktop='^2'
bspc rule -a qutebrowser desktop='^2'
# floating
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

# Start Audio
# start-pulseaudio-x11 &

# Run Awesome program
nitrogen --restore &
pgrep -x polybar > /dev/null || $HOME/.config/polybar/launch.sh &
xset -b & 
# ff-theme-util &
xsetroot -cursor_name left_ptr &

exec_once xfce4-power-manager &
exec_once nm-applet & 
exec_once warpd &
exec_once Telegram &

picom -b &
