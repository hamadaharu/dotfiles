# #######################
# wm independent hotkeys
# #######################

# terminal emulator
# super + Return
#     kitty --single-instance
    # urxvt-run

# program launcher
super + d
	rofi -show drun

# center window
mod3 + k 
    center-window

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

# #######################
# RedShift (Eye Saver)
# #######################
super + r; {1-6}
	redshift -x && redshift -O {1-6}000
super + r; x
	redshift -x 

# #######################
# Screen Shot key
# #######################
Print 
    maim -u ~/Pictures/Screenshots/$(date +"%Y-%m-%d_%H%M%S")_maim.png && \
    notify-send "screenshot has been taken"

ctrl + Print 
    maim -u | xclip -selection clipboard -t image/png && \
    notify-send "screenshot has been copied to clipboard"

super + {_,ctrl} + Print
    { \
        maim -i $(xdotool getactivewindow) -u \ 
        ~/Pictures/Screenshots/$(date +"%Y-%m-%d_%H%M%S")_maim.png && \
        notify-send "screenshot has been taken", \

        maim -i $(xdotool getactivewindow) -u | \
        xclip -selection clipboard -t image/png && \ 
        notify-send "screenshot has been copied to clipboard" \
    }

shift + {_,ctrl} + Print
    { \
        maim -s -u ~/Pictures/Screenshots/$(date +"%Y-%m-%d_%H%M%S")_maim.png && \
        notify-send "screenshot has been taken", \

        maim -s -u | xclip -selection clipboard -t image/png && \
        notify-send "screenshot has been copied to clipboard" \
    }

# #######################
# Picom Controller
# #######################
super + {shift,alt} + t
	{pkill picom, picom -b}

# #######################
# Battery
# #######################
super + underscore
    xset dpms force off
    
super + equal
    xset -dpms && xautolock -disable && notify-send 'Presentation Mode On'

super + minus
    xset dpms && xautolock -enable && notify-send 'Presentation Mode Off'

