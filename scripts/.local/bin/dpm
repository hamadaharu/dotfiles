#!/bin/sh
# Dwm Power Manager

# with openrc use loginctl
[ "$(cat /proc/1/comm)" = "systemd" ] && logind=systemctl || logind=loginctl
LOCK_COMMAND="slock"

case "$1" in
    exit)
        pkill dwm
        ;;
    suspend)
        $logind suspend
        ;;
    hibernate)
        $logind hibernate
        ;;
    reboot)
        $logind reboot
        ;;
    shutdown)
        $logind poweroff
        ;;
    lock)
        $LOCK_COMMAND
        ;;
    *)
        echo "== ! dpm: missing or invalid argument ! =="
        echo "Try again with: exit | lock | suspend | hibernate | reboot | shutdown"
        exit 2
esac

exit 0
